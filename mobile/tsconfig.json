{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "strict": true,
    "resolveJsonModule": true,
    "types": [],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["**/*.ts", "**/*.tsx", "src/types/**/*.d.ts"],
  "exclude": ["**/node_modules", "**/Pods", "**/android", "**/ios"]
}

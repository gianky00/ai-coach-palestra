EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
EXPO_PUBLIC_SENTRY_DSN=https://your-key@o0.ingest.de.sentry.io/0
# Optional Consumer Key. With Client ID, app uses OAuth2 PKCE + edge function `garmin`.
# Leave empty for local demo. Also set Supabase secrets GARMIN_CLIENT_ID / GARMIN_CLIENT_SECRET.
EXPO_PUBLIC_GARMIN_CLIENT_ID=

# Source maps upload during EAS Build (do not commit real token)
SENTRY_ORG=intelleo
SENTRY_PROJECT=kinefit
SENTRY_AUTH_TOKEN=

KINEFIT_SUPABASE_URL=https://your-project.supabase.co
KINEFIT_SUPABASE_ANON_KEY=your-anon-key-here
KINEFIT_SENTRY_DSN=https://your-key@o0.ingest.de.sentry.io/0
# Optional Consumer Key. With Client ID, app uses OAuth2 PKCE + edge function `garmin`.
# Leave empty for local demo. Also set Supabase secrets GARMIN_CLIENT_ID / GARMIN_CLIENT_SECRET.
KINEFIT_GARMIN_CLIENT_ID=

# Source maps upload during release builds (do not commit real token)
SENTRY_ORG=intelleo
SENTRY_PROJECT=kinefit
SENTRY_AUTH_TOKEN=
